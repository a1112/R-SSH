{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r-ssh.dev/schemas/stage7-evidence-manifest-v1.json",
  "title": "R-SSH Stage 7 evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_sha256",
    "requested_state",
    "certified_state",
    "certified_commit",
    "epoch_id",
    "rssh",
    "rterm",
    "created_by",
    "prior_manifest",
    "fragments",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "rssh.stage7-evidence-manifest/v1"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_state": {
      "$ref": "#/$defs/state"
    },
    "certified_state": {
      "$ref": "#/$defs/state"
    },
    "certified_commit": {
      "$ref": "#/$defs/commit"
    },
    "epoch_id": {
      "$ref": "#/$defs/sha256"
    },
    "rssh": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/rsshEpoch"}
      ]
    },
    "rterm": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/rtermEpoch"}
      ]
    },
    "created_by": {
      "const": "assemble-stage7-evidence.py"
    },
    "prior_manifest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/priorManifest"
        }
      ]
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hashedPath"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "attribution-ready",
        "windows-memory-go",
        "cross-platform-go",
        "extraction-ready",
        "dual-source-verified",
        "split-complete"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
    },
    "hashedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "priorManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "certified_state",
        "certified_commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "certified_state": {
          "$ref": "#/$defs/state"
        },
        "certified_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "rsshEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r0_ref", "r2_ref", "r3_deletion_ref", "r3_ref"],
      "properties": {
        "r0_ref": {"$ref": "#/$defs/commit"},
        "r2_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]
        },
        "r3_deletion_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]
        },
        "r3_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]
        }
      }
    },
    "rtermEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filtered_boundary_ref", "r1_ref"],
      "properties": {
        "filtered_boundary_ref": {"$ref": "#/$defs/commit"},
        "r1_ref": {"$ref": "#/$defs/commit"}
      }
    },
    "binaryHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "role",
        "scope",
        "payload_schema",
        "path",
        "sha256",
        "size_bytes",
        "producing_command",
        "producing_argv",
        "source_sha",
        "subject_refs",
        "platform",
        "run_id",
        "cohort_id",
        "children"
      ],
      "properties": {
        "artifact_type": {
          "enum": [
            "font-ownership-raw",
            "font-ownership-aggregate",
            "attribution-matrix-raw",
            "attribution-matrix-aggregate",
            "runner-fingerprint",
            "font-catalog-fingerprint",
            "local-two-bare-git-source-proof",
            "attribution-deterministic-tests",
            "windows-release-build-provenance",
            "windows-first-present-raw",
            "windows-first-frame-raw",
            "windows-empty-window-raw",
            "windows-ssh1-raw",
            "windows-gpu-steady-raw",
            "windows-package-smoke",
            "windows-native-ten-frame",
            "windows-loopback-native-ssh",
            "windows-secret-scan",
            "windows-deterministic-suite",
            "linux-pss-raw",
            "linux-lkg-comparison",
            "linux-native-window",
            "linux-native-pty",
            "linux-native-ssh",
            "linux-package",
            "linux-protected-job-provenance",
            "macos-physical-footprint-raw",
            "macos-lkg-comparison",
            "macos-native-window",
            "macos-native-pty",
            "macos-native-ssh",
            "macos-package",
            "macos-protected-job-provenance",
            "release-contract-v2",
            "rterm-extraction-manifest",
            "source-to-filtered-history-map",
            "full-history-security-scan",
            "rterm-sbom-license",
            "rterm-standalone-ci",
            "task10-dual-repository",
            "rterm-external-source-proof",
            "extraction-rollback-proof",
            "remote-publication-proof",
            "external-consumer-proof",
            "source-switch-rollback-proof",
            "rterm-candidate-protected-ci",
            "dual-source-protected-ci",
            "task10-dual-repository-r2",
            "r2-windows-first-present-raw",
            "r2-windows-first-frame-raw",
            "r2-windows-empty-window-raw",
            "r2-windows-ssh1-raw",
            "r2-windows-gpu-steady-raw",
            "r2-linux-pss-raw",
            "r2-macos-physical-footprint-raw",
            "dual-source-product-results",
            "local-rterm-deletion-proof",
            "split-protected-ci",
            "rterm-protected-release",
            "rssh-protected-release",
            "split-rollback-proof",
            "r3-windows-first-present-raw",
            "r3-windows-first-frame-raw",
            "r3-windows-empty-window-raw",
            "r3-windows-ssh1-raw",
            "r3-windows-gpu-steady-raw",
            "r3-linux-pss-raw",
            "r3-macos-physical-footprint-raw",
            "split-product-results",
            "task10-dual-repository-final",
            "split-security-scan",
            "split-package-results"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "role": {
          "enum": ["raw", "aggregate", "proof"]
        },
        "scope": {
          "$ref": "#/$defs/state"
        },
        "payload_schema": {
          "enum": [
            "rssh.stage7.metric-raw/v1",
            "rssh.stage7.metric-aggregate/v1",
            "rssh.stage7.result/v1"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "producing_command": {
          "type": "string",
          "minLength": 1
        },
        "producing_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_sha": {
          "$ref": "#/$defs/commit"
        },
        "subject_refs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/commit"},
          "propertyNames": {"pattern": "^(rssh|rterm)\\.[a-z0-9_]+$"}
        },
        "binary_hashes": {
          "$ref": "#/$defs/binaryHashes"
        },
        "runner_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "certification_eligible": {
          "type": "boolean"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "cohort_id": {
          "$ref": "#/$defs/sha256"
        },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          }
        }
      }
    }
  }
}
