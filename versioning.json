          "package": "rssh-ssh",
          "format": "semver"
        },
        {
          "path": "Cargo.lock",
          "adapter": "cargo-lock",
          "package": "rssh-test-support",
          "format": "semver"
        },
        {
          "path": "Cargo.lock",
          "adapter": "cargo-lock",
          "package": "rssh-types",
          "format": "semver"
        }
      ],
      "assertions": [
        {
          "path": "crates/rssh-cli/Cargo.toml",
          "adapter": "toml",
          "table": [
            "package",
            "version"
          ],
          "key": "workspace",
          "equals": true
        },
        {
          "path": "crates/rssh-ssh/Cargo.toml",
