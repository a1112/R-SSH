            "package",
            "version"
          ],
          "key": "workspace",
          "equals": true
        },
        {
          "path": "crates/rssh-types/Cargo.toml",
          "adapter": "toml",
          "table": [
            "package",
            "version"
          ],
          "key": "workspace",
          "equals": true
        }
      ],
      "notes": "Rust workspace package version; inherited crate declarations remain source bindings Incoming local Cargo version constraints require native dependency resolution Incoming local Cargo version constraints require native dependency resolution.",
      "read_only": true
    }
  },
  "unmanaged": [
